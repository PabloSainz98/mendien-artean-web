# These settings stay on the server. Never place secrets in site/ or dist/.
PORT=8787
HOST=127.0.0.1
NODE_ENV=development

# Relative paths are resolved from backend/, not from the current shell directory.
DATABASE_PATH=data/app.db
BOOKINGS_CSV_PATH=data/bookings.csv

# Generate a random value: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Empty disables administrative access. A configured token must be at least 32 characters.
ADMIN_TOKEN=
ADMIN_PASSWORD_HASH=
# Configure the panel password interactively: npm run admin:password
# Daily scheduled task: npm run backup. Files stay private; retain 14 snapshots.
BACKUP_DIRECTORY=data/backups
BACKUP_KEEP=14
BACKUP_ENABLED=false
BACKUP_REQUIRED=false
# Explicit maintenance switch, independent from SMTP (guest decisions can still send email).
BOOKING_REQUESTS_ENABLED=true
# Reads per IP / 15 minutes. Public booking submissions are additionally capped at 20.
RATE_LIMIT_MAX=120
TRUST_PROXY=false
REAL_IP_HEADER=
CANONICAL_REDIRECT=false
PUBLIC_ORIGIN=

# Existing email provider's SMTP. No EmailJS or Google Cloud project is used.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
BOOKING_NOTIFICATION_TO=pablosainz1998@gmail.com
SMTP_MESSAGE_DOMAIN=uxarbeiti.local

# Only for local testing. Requests are stored but no notification is sent.
ACCEPT_BOOKINGS_WITHOUT_EMAIL=false
