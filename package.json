{
  "name": "uxarbeiti",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "backend"
  ],
  "overrides": {
    "qs": "^6.16.0"
  },
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node scripts/dev.js",
    "start": "node backend/src/server.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node --test tests/browser.browser.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run build && npm test",
    "admin:password": "node scripts/admin-password.js",
    "check:legal": "node scripts/check-legal.js",
    "release:check": "npm run check:legal && npm run check",
    "backup": "node scripts/backup.js"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "prettier": "^3.9.6"
  }
}
